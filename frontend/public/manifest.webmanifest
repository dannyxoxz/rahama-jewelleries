{
  "id": "/",
  "name": "Rahama Essentials",
  "short_name": "Rahama",
  "description": "Manage Rahama Essentials product photos and catalogue.",
  "start_url": "/admin",
  "scope": "/",
  "display": "standalone",
  "background_color": "#09091b",
  "theme_color": "#09091b",
  "icons": [
    {
      "src": "/rahama-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/rahama-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}
